{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:guanghe:discovery-content:v0.1",
  "title": "光合实习纯内容候选交换协议 v0.1（目标协议，当前后端尚未实现）",
  "description": "仅适用 GitHub/Gitee/AI资料/市场案例的纯内容批次；岗位技术提取仍按现有独立分支。格式校验不表示已经接入线上接口。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "trigger",
    "generated_at",
    "dictionary_version",
    "extractor_version",
    "stats",
    "job_mentions",
    "content_candidates",
    "issues"
  ],
  "properties": {
    "schema_version": {
      "const": "discovery-batch.v0.1"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "trigger": {
      "const": "manual_desktop"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-]\\d{2}:\\d{2})$"
    },
    "dictionary_version": {
      "type": "string",
      "minLength": 0,
      "maxLength": 100
    },
    "extractor_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scanned_jobs",
        "matched_jobs",
        "job_mentions",
        "content_candidates",
        "failed",
        "skipped"
      ],
      "properties": {
        "scanned_jobs": {
          "const": 0
        },
        "matched_jobs": {
          "const": 0
        },
        "job_mentions": {
          "const": 0
        },
        "content_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "job_mentions": {
      "type": "array",
      "maxItems": 0
    },
    "content_candidates": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/definitions/contentCandidate"
      }
    },
    "issues": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "issue_code",
          "message"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "issue_code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "message": {
            "type": "string",
            "minLength": 0,
            "maxLength": 300
          },
          "candidate_key": {
            "anyOf": [
              {
                "const": ""
              },
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            ]
          }
        }
      }
    },
    "search_criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query",
        "limit",
        "sort",
        "created_after"
      ],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "sort": {
          "enum": [
            "stars",
            "updated"
          ]
        },
        "created_after": {
          "anyOf": [
            {
              "const": ""
            },
            {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "content_candidates": {
            "contains": {
              "type": "object",
              "required": [
                "tech_keys"
              ],
              "properties": {
                "tech_keys": {
                  "type": "array",
                  "minItems": 1
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "dictionary_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      }
    }
  ],
  "definitions": {
    "contentCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_key",
        "content_type",
        "source_name",
        "source_url",
        "title",
        "source_published_at",
        "fetched_at",
        "source_evidence_excerpt",
        "proposed_summary",
        "proposed_learning_action",
        "tech_keys",
        "extractor_version",
        "review_state",
        "repository_snapshot"
      ],
      "properties": {
        "candidate_key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "content_type": {
          "enum": [
            "open_source_project",
            "ai_resource",
            "market_case"
          ]
        },
        "source_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "source_url": {
          "type": "string",
          "maxLength": 2000,
          "pattern": "^https://[^\\s]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "source_published_at": {
          "anyOf": [
            {
              "const": ""
            },
            {
              "type": "string",
              "format": "date-time",
              "pattern": "(Z|[+-]\\d{2}:\\d{2})$"
            }
          ]
        },
        "fetched_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|[+-]\\d{2}:\\d{2})$"
        },
        "source_evidence_excerpt": {
          "type": "string",
          "minLength": 0,
          "maxLength": 240
        },
        "proposed_summary": {
          "type": "string",
          "minLength": 0,
          "maxLength": 600
        },
        "proposed_learning_action": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        },
        "tech_keys": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
          }
        },
        "extractor_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "review_state": {
          "const": "pending"
        },
        "platform": {
          "enum": [
            "",
            "github",
            "gitee"
          ]
        },
        "repository_url": {
          "anyOf": [
            {
              "const": ""
            },
            {
              "type": "string",
              "maxLength": 2000,
              "pattern": "^https://[^\\s]+$"
            }
          ]
        },
        "owner": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100
        },
        "repository_name": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "primary_language": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100
        },
        "topics": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "license_spdx": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100
        },
        "readme": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/readme"
            }
          ]
        },
        "repository_snapshot": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/repositorySnapshot"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "content_type": {
                "const": "open_source_project"
              }
            }
          },
          "then": {
            "required": [
              "platform",
              "repository_url",
              "owner",
              "repository_name"
            ],
            "properties": {
              "platform": {
                "enum": [
                  "github",
                  "gitee"
                ]
              },
              "repository_url": {
                "type": "string",
                "maxLength": 2000,
                "pattern": "^https://[^\\s]+$"
              },
              "owner": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "repository_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "repository_snapshot": {
                "$ref": "#/definitions/repositorySnapshot"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "content_type": {
                "enum": [
                  "ai_resource",
                  "market_case"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "platform": {
                "const": ""
              },
              "repository_url": {
                "const": ""
              },
              "owner": {
                "const": ""
              },
              "repository_name": {
                "const": ""
              },
              "repository_snapshot": {
                "type": "null"
              },
              "readme": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "content_type": {
                "const": "market_case"
              }
            }
          },
          "then": {
            "properties": {
              "proposed_summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "source_published_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "(Z|[+-]\\d{2}:\\d{2})$"
              },
              "source_evidence_excerpt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "tech_keys": {
                "type": "array",
                "maxItems": 100,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
                },
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "readme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "source_url",
        "fetched_at",
        "sha",
        "content",
        "size_bytes",
        "truncated",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "fetched",
            "not_found",
            "failed",
            "too_large",
            "rate_limited"
          ]
        },
        "source_url": {
          "type": "string",
          "maxLength": 2000,
          "pattern": "^https://[^\\s]+$"
        },
        "fetched_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|[+-]\\d{2}:\\d{2})$"
        },
        "sha": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{40}|[0-9a-fA-F]{64})?$"
        },
        "content": {
          "type": "string",
          "minLength": 0,
          "maxLength": 12000
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 0,
          "maxLength": 300
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "fetched"
              }
            }
          },
          "then": {
            "properties": {
              "sha": {
                "minLength": 40
              }
            }
          },
          "else": {
            "properties": {
              "content": {
                "const": ""
              }
            }
          }
        }
      ]
    },
    "repositorySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_key",
        "fetched_at",
        "stars",
        "forks",
        "pushed_at",
        "archived"
      ],
      "properties": {
        "candidate_key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "fetched_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|[+-]\\d{2}:\\d{2})$"
        },
        "stars": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "forks": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "pushed_at": {
          "anyOf": [
            {
              "const": ""
            },
            {
              "type": "string",
              "format": "date-time",
              "pattern": "(Z|[+-]\\d{2}:\\d{2})$"
            }
          ]
        },
        "archived": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    }
  }
}
